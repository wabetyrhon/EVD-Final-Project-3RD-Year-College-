FLASK_APP=backend
DB_URI=(your database URI)
SECRET_KEY=(your flask secret key)
DEV_SECRET=(password hash using generate_password_hash from werkzeug.security)
ADMIN_HASH=(password hash using generate_password_hash from werkzeug.security)
GMAIL_CLIENT_ID=(your Gmail API client id)
GMAIL_CLIENT_SECRET=(your Gmail API client secret)
GMAIL_REFRESH_TOKEN=(your Gmail API refresh token)
